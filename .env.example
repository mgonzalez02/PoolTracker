# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides
# DATABASE_URL=sqlite:///instance/pooltracker.db
# SESSION_COOKIE_SECURE=true

# Public hostname used to build links in emails (e.g. password resets).
# Without this, links are built from whatever Host header the request came
# in on, which is wrong behind a proxy or reverse-DNS setup. No trailing slash.
# APP_BASE_URL=https://pool.example.com

# SMTP settings for "forgot password" emails. Leave MAIL_SERVER blank to
# disable emailing (the login page's "Forgot password?" link will tell users
# to contact an admin instead).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=an-app-password-not-your-real-password
# MAIL_DEFAULT_SENDER=you@example.com
